{
  "name": "khatwat-batal-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "خطوة بطل — تطبيق شخصي للتحديات والجوائز والأبطال ولعبة بطاقات تكتيكية (PWA)",
  "scripts": {
    "dev": "vite",
    "build": "npm run verify:assets && tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "assets:prepare": "node scripts/prepare-assets.mjs",
    "verify:assets": "node scripts/verify-assets.mjs"
  },
  "dependencies": {
    "@fontsource/tajawal": "^5.3.0",
    "fflate": "^0.8.3",
    "idb": "^8.0.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.3",
    "workbox-build": "^7.4.1",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
